@startuml classes-01
!pragma layout smetana
skinparam monochrome true
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam classBackgroundColor white
skinparam packageBackgroundColor white
skinparam legendBackgroundColor white
skinparam classBorderColor black
skinparam ArrowColor black
skinparam NoteBackgroundColor white
skinparam NoteBorderColor black
skinparam nodesep 36
skinparam ranksep 45
hide circle
title Пакеты и направление зависимостей
package "core" as core {
  note as coreNote
    31 исходный файл
    Сущности, правила, алгоритмы,
    результаты, сценарии и порты
    Только стандартная библиотека JDK
  end note
}
package "main" as adapters {
  note as adaptersNote
    4 исходных файла
    Чтение JSON, аргументы CLI,
    текстовое и JSON-представление
    Gson - во внешних адаптерах
  end note
}
class Main
Main ..> core : создаёт и вызывает
Main ..> adapters : подключает адаптеры
adapters ..> core : использует типы и порты
legend bottom
Физические пакеты соответствуют каталогам src/java/core и src/java/main.
Main находится в src/java без объявления пакета.
Стрелка указывает на используемый пакет.
endlegend
@enduml




