<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Readiness" targetNamespace="https://github.com/kokuyouu/practice/kt2">
  <bpmn:collaboration id="Collaboration_Readiness">
    <bpmn:participant id="Agency" name="Контроль готовности этапа" processRef="Process_Readiness"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Readiness" isExecutable="false" name="Контроль готовности этапа иммерсивной кампании к согласованию">
    <bpmn:laneSet id="LaneSet_Readiness">
      <bpmn:lane id="Manager" name="Менеджер проекта">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Issues</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BlockedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="System" name="Программная система">
        <bpmn:flowNodeRef>Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ErrorEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Brief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Summary</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Получен запрос на проверку этапа">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Select" name="Задать заказ, этап и дату проверки">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Load" name="Загрузить и проверить входные данные">
      <bpmn:documentation>src/data.py: load_data(); при ошибке CLI возвращает код 2.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:ioSpecification id="Load_IO"><bpmn:dataInput id="Load_clients" name="clients" isCollection="true"/><bpmn:dataInput id="Load_orders" name="orders" isCollection="true"/><bpmn:dataInput id="Load_employees" name="employees" isCollection="true"/><bpmn:dataInput id="Load_order_members" name="order_members" isCollection="true"/><bpmn:dataInput id="Load_stages" name="stages" isCollection="true"/><bpmn:dataInput id="Load_tasks" name="tasks" isCollection="true"/><bpmn:dataInput id="Load_materials" name="materials" isCollection="true"/><bpmn:dataInput id="Load_material_versions" name="material_versions" isCollection="true"/><bpmn:dataInput id="Load_task_materials" name="task_materials" isCollection="true"/><bpmn:dataInput id="Load_approvals" name="approvals" isCollection="true"/><bpmn:dataInput id="Load_comments" name="comments" isCollection="true"/><bpmn:inputSet id="Load_InputSet"><bpmn:dataInputRefs>Load_clients</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_orders</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_employees</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_order_members</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_stages</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_tasks</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_materials</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_material_versions</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_task_materials</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_approvals</bpmn:dataInputRefs><bpmn:dataInputRefs>Load_comments</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="Load_OutputSet"/></bpmn:ioSpecification><bpmn:dataInputAssociation id="Input_clients">
        <bpmn:sourceRef>Ref_clients</bpmn:sourceRef>
        <bpmn:targetRef>Load_clients</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_orders">
        <bpmn:sourceRef>Ref_orders</bpmn:sourceRef>
        <bpmn:targetRef>Load_orders</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_employees">
        <bpmn:sourceRef>Ref_employees</bpmn:sourceRef>
        <bpmn:targetRef>Load_employees</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_order_members">
        <bpmn:sourceRef>Ref_order_members</bpmn:sourceRef>
        <bpmn:targetRef>Load_order_members</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_stages">
        <bpmn:sourceRef>Ref_stages</bpmn:sourceRef>
        <bpmn:targetRef>Load_stages</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_tasks">
        <bpmn:sourceRef>Ref_tasks</bpmn:sourceRef>
        <bpmn:targetRef>Load_tasks</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_materials">
        <bpmn:sourceRef>Ref_materials</bpmn:sourceRef>
        <bpmn:targetRef>Load_materials</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_material_versions">
        <bpmn:sourceRef>Ref_material_versions</bpmn:sourceRef>
        <bpmn:targetRef>Load_material_versions</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_task_materials">
        <bpmn:sourceRef>Ref_task_materials</bpmn:sourceRef>
        <bpmn:targetRef>Load_task_materials</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_approvals">
        <bpmn:sourceRef>Ref_approvals</bpmn:sourceRef>
        <bpmn:targetRef>Load_approvals</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="Input_comments">
        <bpmn:sourceRef>Ref_comments</bpmn:sourceRef>
        <bpmn:targetRef>Load_comments</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Invalid" name="Ошибка входных данных" attachedToRef="Load" cancelActivity="true">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDefinition_Invalid"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="ErrorEnd" name="Проверка прекращена">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Brief" name="Проверить обязательные поля брифа">
      <bpmn:documentation>Реализовано в src/operations.py: check_brief()</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Ready" name="Проверить готовность этапа к согласованию">
      <bpmn:documentation>Реализовано в src/operations.py: check_stage_readiness()</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Overdue" name="Найти просроченные задачи и упорядочить их по сроку">
      <bpmn:documentation>Реализовано в src/operations.py: find_overdue_tasks()</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Summary" name="Сформировать сводку по заказу">
      <bpmn:documentation>Реализовано в src/operations.py: build_order_summary()</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Assess" name="Оценить результаты проверки">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Decision" name="Бриф полный и этап готов?">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ReadyEnd" name="Этап готов">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Issues" name="Составить перечень уточнений и доработок">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="BlockedEnd" name="Перечень доработок подготовлен">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Select"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Select" targetRef="Load"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Load" targetRef="Brief"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Brief" targetRef="Ready"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Ready" targetRef="Overdue"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Overdue" targetRef="Summary"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Invalid" targetRef="ErrorEnd"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Summary" targetRef="Assess"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Assess" targetRef="Decision"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Decision" targetRef="ReadyEnd" name="Да"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Decision" targetRef="Issues" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Issues" targetRef="BlockedEnd"/>
    <bpmn:dataObject id="Data_clients" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_clients" name="Сведения о клиенте&#10;clients" dataObjectRef="Data_clients"/>
    <bpmn:dataObject id="Data_orders" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_orders" name="Карточка заказа и бриф&#10;orders" dataObjectRef="Data_orders"/>
    <bpmn:dataObject id="Data_employees" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_employees" name="Сотрудники&#10;employees" dataObjectRef="Data_employees"/>
    <bpmn:dataObject id="Data_order_members" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_order_members" name="Участие в заказе&#10;order_members" dataObjectRef="Data_order_members"/>
    <bpmn:dataObject id="Data_stages" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_stages" name="План этапов&#10;stages" dataObjectRef="Data_stages"/>
    <bpmn:dataObject id="Data_tasks" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_tasks" name="Производственные задачи&#10;tasks" dataObjectRef="Data_tasks"/>
    <bpmn:dataObject id="Data_materials" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_materials" name="Материалы&#10;materials" dataObjectRef="Data_materials"/>
    <bpmn:dataObject id="Data_material_versions" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_material_versions" name="Версии материалов&#10;material_versions" dataObjectRef="Data_material_versions"/>
    <bpmn:dataObject id="Data_task_materials" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_task_materials" name="Результаты задач&#10;task_materials" dataObjectRef="Data_task_materials"/>
    <bpmn:dataObject id="Data_approvals" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_approvals" name="Решения клиента&#10;approvals" dataObjectRef="Data_approvals"/>
    <bpmn:dataObject id="Data_comments" isCollection="true"/>
    <bpmn:dataObjectReference id="Ref_comments" name="Замечания к версиям&#10;comments" dataObjectRef="Data_comments"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Main">
    <bpmndi:BPMNPlane id="Plane_Main" bpmnElement="Collaboration_Readiness">
      <bpmndi:BPMNShape id="Main_Agency_di" bpmnElement="Agency" isHorizontal="false">
        <dc:Bounds x="50" y="50" width="1760" height="1510"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Manager_di" bpmnElement="Manager" isHorizontal="false">
        <dc:Bounds x="50" y="80" width="400" height="1480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_System_di" bpmnElement="System" isHorizontal="false">
        <dc:Bounds x="450" y="80" width="1360" height="1480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Start_di" bpmnElement="Start">
        <dc:Bounds x="232" y="130" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="75" y="125" width="145" height="75"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Select_di" bpmnElement="Select">
        <dc:Bounds x="140" y="240" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Load_di" bpmnElement="Load">
        <dc:Bounds x="560" y="240" width="400" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Invalid_di" bpmnElement="Invalid">
        <dc:Bounds x="908" y="324" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="970" y="330" width="190" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_ErrorEnd_di" bpmnElement="ErrorEnd">
        <dc:Bounds x="1015" y="410" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="960" y="455" width="160" height="45"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Brief_di" bpmnElement="Brief" color:background-color="#dcecf7" color:border-color="#245979">
        <dc:Bounds x="560" y="440" width="400" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Ready_di" bpmnElement="Ready" color:background-color="#dcecf7" color:border-color="#245979">
        <dc:Bounds x="560" y="640" width="400" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Overdue_di" bpmnElement="Overdue" color:background-color="#dcecf7" color:border-color="#245979">
        <dc:Bounds x="560" y="840" width="400" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Summary_di" bpmnElement="Summary" color:background-color="#dcecf7" color:border-color="#245979">
        <dc:Bounds x="560" y="1040" width="400" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Assess_di" bpmnElement="Assess">
        <dc:Bounds x="140" y="1040" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Decision_di" bpmnElement="Decision">
        <dc:Bounds x="225" y="1200" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="65" y="1170" width="145" height="80"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_ReadyEnd_di" bpmnElement="ReadyEnd">
        <dc:Bounds x="360" y="1320" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="1370" width="110" height="95"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_Issues_di" bpmnElement="Issues">
        <dc:Bounds x="100" y="1320" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Main_BlockedEnd_di" bpmnElement="BlockedEnd">
        <dc:Bounds x="192" y="1480" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="1465" width="180" height="65"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="250" y="166"/>
        <di:waypoint x="250" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="360" y="290"/>
        <di:waypoint x="560" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="760.0" y="340"/>
        <di:waypoint x="760.0" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="760.0" y="540"/>
        <di:waypoint x="760.0" y="640"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="760.0" y="740"/>
        <di:waypoint x="760.0" y="840"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="760.0" y="940"/>
        <di:waypoint x="760.0" y="1040"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="926" y="360"/>
        <di:waypoint x="926" y="385"/>
        <di:waypoint x="1033" y="385"/>
        <di:waypoint x="1033" y="410"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="560" y="1090"/>
        <di:waypoint x="360" y="1090"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="250" y="1140"/>
        <di:waypoint x="250" y="1200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="275" y="1225"/>
        <di:waypoint x="378" y="1225"/>
