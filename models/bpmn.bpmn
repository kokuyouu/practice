<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Agency" targetNamespace="https://github.com/kokuyouu/practice/kt2">
  <bpmn:collaboration id="Collaboration_Agency">
    <bpmn:participant id="Client" name="Клиент"/>
    <bpmn:participant id="Agency" name="Агентство иммерсивного маркетинга" processRef="Process_Agency"/>
    <bpmn:messageFlow id="Flow_30" sourceRef="Client" targetRef="Start" name="Бриф"/>
    <bpmn:messageFlow id="Flow_31" sourceRef="Clarify" targetRef="Client" name="Вопросы"/>
    <bpmn:messageFlow id="Flow_32" sourceRef="Client" targetRef="Clarified" name="Уточнения"/>
    <bpmn:messageFlow id="Flow_33" sourceRef="Proposal" targetRef="Client" name="Предложение"/>
    <bpmn:messageFlow id="Flow_34" sourceRef="Client" targetRef="ProposalReply" name="Решение"/>
    <bpmn:messageFlow id="Flow_35" sourceRef="SendVersion" targetRef="Client" name="Версия"/>
    <bpmn:messageFlow id="Flow_36" sourceRef="Client" targetRef="VersionReply" name="Решение"/>
    <bpmn:messageFlow id="Flow_37" sourceRef="Client" targetRef="Acceptance" name="Приёмка"/>
    <bpmn:messageFlow id="Flow_38" sourceRef="Close" targetRef="Client" name="Материалы"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Agency" name="Подготовка и реализация иммерсивной рекламной кампании по заказу клиента" isExecutable="false">
    <bpmn:laneSet id="Process_Agency_lanes">
      <bpmn:lane id="Lane_Manager" name="Менеджер проекта">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Brief</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BriefOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Clarified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Concept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Proposal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProposalReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProposalOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Overdue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Production</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReadyOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SendVersion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VersionReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VersionOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Launch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Acceptance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Cancelled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Аналитик">
        <bpmn:flowNodeRef>Summary</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Бриф клиента получен">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_message"/>
    </bpmn:startEvent>
    <bpmn:userTask id="Register" name="Зарегистрировать&#10;заказ">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Client_assoc">
        <bpmn:targetRef>Data_Client</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Brief" name="Проверить обязательные&#10;поля брифа">
      <bpmn:documentation>Планируемая автоматизация в КТ2: check_brief()</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Order_assoc">
        <bpmn:targetRef>Data_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BriefOK" name="Бриф полный?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Clarify" name="Запросить уточнение&#10;брифа">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Clarified" name="Уточнённый бриф получен">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Clarified_message"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="Concept" name="Подготовить концепцию,&#10;сценарий и смету">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:laneSet id="Concept_lanes">
        <bpmn:lane id="CL_marketing" name="Маркетолог">
          <bpmn:flowNodeRef>CStart</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Scenario</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CFork</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="CL_design" name="Дизайнер">
          <bpmn:flowNodeRef>Design</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="CL_dev" name="Разработчик">
          <bpmn:flowNodeRef>Feasibility</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="CL_manager" name="Менеджер проекта">
          <bpmn:flowNodeRef>CJoin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Estimate</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>CEnd</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="CStart" name="Подготовить предложение">
        <bpmn:outgoing>Flow_39</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Scenario" name="Разработать&#10;пользовательский сценарий">
        <bpmn:incoming>Flow_39</bpmn:incoming>
        <bpmn:outgoing>Flow_40</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="CFork" name="">
        <bpmn:incoming>Flow_40</bpmn:incoming>
        <bpmn:outgoing>Flow_41</bpmn:outgoing>
        <bpmn:outgoing>Flow_42</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Design" name="Подготовить визуальную&#10;концепцию">
        <bpmn:incoming>Flow_41</bpmn:incoming>
        <bpmn:outgoing>Flow_46</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Feasibility" name="Оценить техническую&#10;реализуемость">
        <bpmn:incoming>Flow_42</bpmn:incoming>
        <bpmn:outgoing>Flow_43</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="CJoin" name="">
        <bpmn:incoming>Flow_43</bpmn:incoming>
        <bpmn:incoming>Flow_46</bpmn:incoming>
        <bpmn:outgoing>Flow_44</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Estimate" name="Сформировать смету&#10;и сроки">
        <bpmn:incoming>Flow_44</bpmn:incoming>
        <bpmn:outgoing>Flow_45</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="CEnd" name="Предложение подготовлено">
        <bpmn:incoming>Flow_45</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_39" sourceRef="CStart" targetRef="Scenario"/>
      <bpmn:sequenceFlow id="Flow_40" sourceRef="Scenario" targetRef="CFork"/>
      <bpmn:sequenceFlow id="Flow_41" sourceRef="CFork" targetRef="Design"/>
      <bpmn:sequenceFlow id="Flow_42" sourceRef="CFork" targetRef="Feasibility"/>
      <bpmn:sequenceFlow id="Flow_43" sourceRef="Feasibility" targetRef="CJoin"/>
      <bpmn:sequenceFlow id="Flow_44" sourceRef="CJoin" targetRef="Estimate"/>
      <bpmn:sequenceFlow id="Flow_45" sourceRef="Estimate" targetRef="CEnd"/>
      <bpmn:sequenceFlow id="Flow_46" sourceRef="Design" targetRef="CJoin"/>
    </bpmn:subProcess>
    <bpmn:sendTask id="Proposal" name="Отправить предложение&#10;клиенту">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="ProposalReply" name="Получить решение&#10;по предложению">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="ProposalOK" name="Решение клиента?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Plan" name="Сформировать этапы,&#10;задачи и команду">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Staff_assoc">
        <bpmn:targetRef>Data_Staff</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Data_Members_assoc">
        <bpmn:targetRef>Data_Members</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Data_Stages_assoc">
        <bpmn:targetRef>Data_Stages</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:userTask id="Overdue" name="Найти просроченные задачи&#10;и упорядочить их по сроку">
      <bpmn:documentation>Планируемая автоматизация в КТ2: find_overdue_tasks()</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Tasks_assoc">
        <bpmn:targetRef>Data_Tasks</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:subProcess id="Production" name="Произвести и проверить&#10;версию кампании">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Material_assoc">
        <bpmn:targetRef>Data_Material</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:laneSet id="Production_lanes">
        <bpmn:lane id="PL_manager" name="Менеджер проекта">
          <bpmn:flowNodeRef>PStart</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>PFork</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Fix</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="PL_design" name="Дизайнер">
          <bpmn:flowNodeRef>Visuals</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="PL_dev" name="Разработчик">
          <bpmn:flowNodeRef>Interactive</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>PJoin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Build</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="PL_tech" name="Технический специалист">
          <bpmn:flowNodeRef>Environment</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="PL_test" name="Тестировщик">
          <bpmn:flowNodeRef>Test</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>TestOK</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>PEnd</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="PStart" name="Работы назначены">
        <bpmn:outgoing>Flow_47</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="PFork" name="">
        <bpmn:incoming>Flow_47</bpmn:incoming>
        <bpmn:incoming>Flow_59</bpmn:incoming>
        <bpmn:outgoing>Flow_48</bpmn:outgoing>
        <bpmn:outgoing>Flow_49</bpmn:outgoing>
        <bpmn:outgoing>Flow_50</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Visuals" name="Создать визуальные&#10;материалы">
        <bpmn:incoming>Flow_48</bpmn:incoming>
        <bpmn:outgoing>Flow_55</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Interactive" name="Реализовать интерактивный&#10;сценарий">
        <bpmn:incoming>Flow_49</bpmn:incoming>
        <bpmn:outgoing>Flow_51</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Environment" name="Подготовить оборудование&#10;или среду запуска">
        <bpmn:incoming>Flow_50</bpmn:incoming>
        <bpmn:outgoing>Flow_56</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:parallelGateway id="PJoin" name="">
        <bpmn:incoming>Flow_51</bpmn:incoming>
        <bpmn:incoming>Flow_55</bpmn:incoming>
        <bpmn:incoming>Flow_56</bpmn:incoming>
        <bpmn:outgoing>Flow_52</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:userTask id="Build" name="Собрать версию&#10;результата">
        <bpmn:incoming>Flow_52</bpmn:incoming>
        <bpmn:outgoing>Flow_53</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Test" name="Провести внутреннюю&#10;проверку версии">
        <bpmn:incoming>Flow_53</bpmn:incoming>
        <bpmn:outgoing>Flow_54</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="TestOK" name="Есть блокирующие&#10;ошибки?">
        <bpmn:incoming>Flow_54</bpmn:incoming>
        <bpmn:outgoing>Flow_57</bpmn:outgoing>
        <bpmn:outgoing>Flow_58</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Fix" name="Назначить исправления&#10;по результатам проверки">
        <bpmn:incoming>Flow_58</bpmn:incoming>
        <bpmn:outgoing>Flow_59</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="PEnd" name="Версия проверена">
        <bpmn:incoming>Flow_57</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_47" sourceRef="PStart" targetRef="PFork"/>
      <bpmn:sequenceFlow id="Flow_48" sourceRef="PFork" targetRef="Visuals"/>
      <bpmn:sequenceFlow id="Flow_49" sourceRef="PFork" targetRef="Interactive"/>
      <bpmn:sequenceFlow id="Flow_50" sourceRef="PFork" targetRef="Environment"/>
      <bpmn:sequenceFlow id="Flow_51" sourceRef="Interactive" targetRef="PJoin"/>
      <bpmn:sequenceFlow id="Flow_52" sourceRef="PJoin" targetRef="Build"/>
      <bpmn:sequenceFlow id="Flow_53" sourceRef="Build" targetRef="Test"/>
      <bpmn:sequenceFlow id="Flow_54" sourceRef="Test" targetRef="TestOK"/>
      <bpmn:sequenceFlow id="Flow_55" sourceRef="Visuals" targetRef="PJoin"/>
      <bpmn:sequenceFlow id="Flow_56" sourceRef="Environment" targetRef="PJoin"/>
      <bpmn:sequenceFlow id="Flow_57" sourceRef="TestOK" targetRef="PEnd" name="Нет">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_58" sourceRef="TestOK" targetRef="Fix" name="Да">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_59" sourceRef="Fix" targetRef="PFork"/>
    </bpmn:subProcess>
    <bpmn:userTask id="Ready" name="Проверить готовность этапа&#10;к согласованию">
      <bpmn:documentation>Планируемая автоматизация в КТ2: check_stage_readiness()</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Version_assoc">
        <bpmn:targetRef>Data_Version</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="Data_Result_assoc">
        <bpmn:targetRef>Data_Result</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ReadyOK" name="Этап готов?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SendVersion" name="Передать проверенную&#10;версию клиенту">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="VersionReply" name="Получить решение&#10;по версии">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Approval_assoc">
        <bpmn:targetRef>Data_Approval</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="VersionOK" name="Решение клиента?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Rework" name="Зафиксировать замечания&#10;и задачи доработки">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="Data_Comment_assoc">
        <bpmn:targetRef>Data_Comment</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:subProcess id="Launch" name="Запустить или передать&#10;согласованную кампанию">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
      <bpmn:laneSet id="Launch_lanes">
        <bpmn:lane id="LL_manager" name="Менеджер проекта">
          <bpmn:flowNodeRef>LStart</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Physical</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>LJoin</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>Instructions</bpmn:flowNodeRef>
          <bpmn:flowNodeRef>LEnd</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="LL_tech" name="Технический специалист">
          <bpmn:flowNodeRef>Mount</bpmn:flowNodeRef>
        </bpmn:lane>
        <bpmn:lane id="LL_dev" name="Разработчик">
          <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        </bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="LStart" name="Версия согласована">
        <bpmn:outgoing>Flow_60</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Physical" name="Физическая&#10;площадка?">
        <bpmn:incoming>Flow_60</bpmn:incoming>
        <bpmn:outgoing>Flow_61</bpmn:outgoing>
        <bpmn:outgoing>Flow_62</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Mount" name="Смонтировать и настроить&#10;инсталляцию">
        <bpmn:incoming>Flow_61</bpmn:incoming>
        <bpmn:outgoing>Flow_63</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Publish" name="Опубликовать цифровую&#10;кампанию">
        <bpmn:incoming>Flow_62</bpmn:incoming>
        <bpmn:outgoing>Flow_64</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="LJoin" name="">
        <bpmn:incoming>Flow_63</bpmn:incoming>
        <bpmn:incoming>Flow_64</bpmn:incoming>
        <bpmn:outgoing>Flow_65</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Instructions" name="Передать инструкции&#10;клиенту">
        <bpmn:incoming>Flow_65</bpmn:incoming>
        <bpmn:outgoing>Flow_66</bpmn:outgoing>
      </bpmn:userTask>
