        <bpmndi:BPMNLabel>
          <dc:Bounds x="310" y="1230" width="55" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="250" y="1250"/>
        <di:waypoint x="250" y="1280"/>
        <di:waypoint x="210" y="1280"/>
        <di:waypoint x="210" y="1320"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="1255" width="60" height="30"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="210" y="1420"/>
        <di:waypoint x="210" y="1480"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Main_Ref_clients_di" bpmnElement="Ref_clients">
        <dc:Bounds x="1210" y="220" width="50" height="65"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="290" width="235" height="75"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Input_clients_di" bpmnElement="Input_clients">
        <di:waypoint x="1235" y="220"/><di:waypoint x="1235" y="180"/><di:waypoint x="1130" y="180"/><di:waypoint x="1130" y="290"/><di:waypoint x="960" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Main_Ref_orders_di" bpmnElement="Ref_orders">
        <dc:Bounds x="1530" y="220" width="50" height="65"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1440" y="290" width="235" height="75"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Input_orders_di" bpmnElement="Input_orders">
        <di:waypoint x="1555" y="220"/><di:waypoint x="1555" y="180"/><di:waypoint x="1134" y="180"/><di:waypoint x="1134" y="290"/><di:waypoint x="960" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Main_Ref_employees_di" bpmnElement="Ref_employees">
        <dc:Bounds x="1210" y="425" width="50" height="65"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="495" width="235" height="75"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Input_employees_di" bpmnElement="Input_employees">
        <di:waypoint x="1235" y="425"/><di:waypoint x="1235" y="385"/><di:waypoint x="1138" y="385"/><di:waypoint x="1138" y="290"/><di:waypoint x="960" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Main_Ref_order_members_di" bpmnElement="Ref_order_members">
        <dc:Bounds x="1530" y="425" width="50" height="65"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1440" y="495" width="235" height="75"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Input_order_members_di" bpmnElement="Input_order_members">
