      <bpmn:sequenceFlow id="Flow_61" sourceRef="Physical" targetRef="Mount" name="Да">
        <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_62" sourceRef="Physical" targetRef="Publish" name="Нет">
